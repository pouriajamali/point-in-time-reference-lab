  "$id": "urn:pouria:dotnet11-host-qualification:v1",
  "$defs": {
    "consumerAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "state",
        "projectId",
        "producerFactSha256",
        "admittedFor",
        "currentExecution",
        "identityRule"
      ],
      "properties": {
        "schema": {
          "const": "sdk11-consumer-host-admission/v1"
        },
        "state": {
          "const": "ADMITTED_EXACT_SUPPORTED_HOST_CLASS"
        },
        "projectId": {
          "type": "string",
          "pattern": "^0[1-6]$"
        },
        "producerFactSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "admittedFor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hostClass",
            "rid",
            "sdk",
            "runtime",
            "memberManifestSha256",
            "contractSha256",
            "sourcePinTableSha256",
            "controllerSha256",
            "profileSha256"
          ],
          "properties": {
            "hostClass": {
              "enum": [
                "GitHubHostedWindowsServer2025x64",
                "GitHubHostedUbuntu24.04x64"
              ]
            },
            "rid": {
              "enum": [
                "win-x64",
                "linux-x64"
              ]
            },
            "sdk": {
              "const": "11.0.100"
            },
            "runtime": {
              "const": "11.0.0"
            },
            "memberManifestSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "contractSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "sourcePinTableSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "controllerSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "profileSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "currentExecution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId",
            "job",
            "attempt",
            "instanceId",
            "ownCapsEvidenceSha256"
          ],
          "properties": {
            "runId": {
              "type": "string",
              "maxLength": 4096
            },
            "job": {
              "type": "string",
              "maxLength": 4096
            },
            "attempt": {
              "type": "string",
              "maxLength": 4096
            },
            "instanceId": {
              "type": "string",
              "maxLength": 4096
            },
            "ownCapsEvidenceSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "identityRule": {
          "const": "QUALIFIED_ON_IS_HISTORICAL_PRODUCER_INSTANCE_CURRENT_CONSUMER_JOB_MAY_DIFFER"
        }
      }
    }
  }
}
